# Alma Mater landing page — server-side environment variables.
# Copy to .env.local and fill in real values locally. Never commit a real
# .env file; .gitignore covers every .env* except this example.

# Supabase project URL (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase service role key (Project Settings → API). Server-only: it bypasses
# row level security, so it must never ship to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Secret that salts the HMAC-SHA256 hash of caller IPs for rate limiting.
# Generate with: openssl rand -hex 32
IP_HASH_SECRET=
